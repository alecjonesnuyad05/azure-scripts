# Configuration for mysql_migrate_db.sh.
# Copy to ".env.mysql" (or ".env") in this same directory; the script auto-loads it.
#   cp .env.mysql.example .env.mysql
# CLI flags override anything set here. Do NOT commit the real file.

# --- Admin passwords (required unless you use ~/.my.cnf) ---
SRC_MYSQL_PWD=
DST_MYSQL_PWD=

# --- Connection defaults (optional; equivalent to the matching CLI flags) ---
#SRC_HOST=born1
#SRC_PORT=3306
#SRC_ADMIN=root

#DST_HOST=born3
#DST_PORT=3306
#DST_ADMIN=root

# --- Migration defaults (optional) ---
#DB=mydb
#DST_DB=mydb
