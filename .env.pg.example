# Configuration for pg_migrate_db.sh.
# Copy to ".env.pg" (or ".env") in this same directory; the script auto-loads it.
#   cp .env.pg.example .env.pg
# CLI flags override anything set here. Do NOT commit the real file.

# --- Admin passwords (required unless you use ~/.pgpass) ---
SRC_PGPASSWORD=
DST_PGPASSWORD=

# --- Connection defaults (optional; equivalent to the matching CLI flags) ---
#SRC_HOST=born1
#SRC_PORT=5432
#SRC_ADMIN=postgres

#DST_HOST=born3
#DST_PORT=5432
#DST_ADMIN=postgres

# --- Migration defaults (optional) ---
#DB=mydb
#DST_DB=mydb
