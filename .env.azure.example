# Configuration for azure_migrate_disk.sh and azure_migrate_container.sh.
# Copy to ".env.azure" (or ".env") in this same directory; the script auto-loads it.
#   cp .env.azure.example .env.azure
# CLI flags override anything set here. Do NOT commit the real file.

# --- Service principal creds (optional; omit to reuse an existing `az login`
#     session that already has the matching subscription in its token cache) ---
SRC_AZURE_TENANT_ID=
SRC_AZURE_CLIENT_ID=
SRC_AZURE_CLIENT_SECRET=

DST_AZURE_TENANT_ID=
DST_AZURE_CLIENT_ID=
DST_AZURE_CLIENT_SECRET=

# --- azure_migrate_container.sh only: storage account keys, as an
#     alternative to the service principal creds above. If set, that side
#     skips `az login` and --src-rg/--src-subscription (or dst-) entirely —
#     but the account itself must already exist, since creating one needs
#     an authenticated session. An account key grants full read/write on
#     the ENTIRE account (every container), so treat it like a root
#     password; prefer the service-principal creds above when you can. ---
SRC_ACCOUNT_KEY=
DST_ACCOUNT_KEY=

# --- Connection defaults (optional; equivalent to the matching CLI flags) ---
#SRC_RG=
#SRC_SUB=

#DST_RG=
#DST_SUB=
#DST_LOCATION=

# --- Migration defaults (optional) ---
#DISK=
#DST_DISK=
#SKU=
#STAGING_ACCOUNT=
#STAGING_CONTAINER=diskmigration
#SAS_DURATION=14400

# --- azure_migrate_container.sh defaults (optional) ---
#CONTAINER=
#DST_CONTAINER=
#SRC_ACCOUNT=
#DST_ACCOUNT=
#DST_SKU=Standard_LRS
